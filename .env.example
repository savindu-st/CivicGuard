# ==============================================================================
# Civic Guard - Master Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the values with your actual configuration.

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (From: Project Settings -> API & Database)
# ------------------------------------------------------------------------------
# Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public Anon Key (safe for client/citizen apps)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (BYPASSES RLS - Use ONLY in backend Node.js microservices)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Supabase Storage Buckets
SUPABASE_STORAGE_INCIDENT_BUCKET=incident-photos
SUPABASE_STORAGE_RESOLUTION_BUCKET=resolution-photos

# ------------------------------------------------------------------------------
# 2. API Gateway (Kong) Ports
# ------------------------------------------------------------------------------
KONG_PORT=8000
KONG_ADMIN_PORT=8001

# ------------------------------------------------------------------------------
# 3. Microservices Ports (Local & Host bindings)
# ------------------------------------------------------------------------------
INCIDENT_SERVICE_PORT=4001
TICKET_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003
RELIEF_SERVICE_PORT=4004
AI_SERVICE_PORT=5000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 4. Internal Microservice URLs (Used in Docker Compose & Inter-Service Calls)
# ------------------------------------------------------------------------------
INCIDENT_SERVICE_URL=http://incident-service:4001
TICKET_SERVICE_URL=http://ticket-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4003
RELIEF_SERVICE_URL=http://relief-service:4004
AI_SERVICE_URL=http://ai-service:5000

# ------------------------------------------------------------------------------
# 5. Security, JWT & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=super_secret_civicguard_jwt_token_key_change_me_32char
SOCKET_CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 6. Operations Web Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:4003
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
