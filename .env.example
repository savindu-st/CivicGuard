# ==========================================
# CodeArena'26 - Civic Guard Environment Config
# ==========================================

# Supabase PostgreSQL & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# API Gateway (Kong)
KONG_PORT=8000
KONG_ADMIN_PORT=8001

# Microservices Ports
INCIDENT_SERVICE_PORT=4001
TICKET_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003
RELIEF_SERVICE_PORT=4004
AI_SERVICE_PORT=5000
WEB_PORT=3000

# Internal Service URLs (Docker Networking)
INCIDENT_SERVICE_URL=http://incident-service:4001
TICKET_SERVICE_URL=http://ticket-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4003
RELIEF_SERVICE_URL=http://relief-service:4004
AI_SERVICE_URL=http://ai-service:5000

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NODE_ENV=development

# Real-time WebSocket
SOCKET_CORS_ORIGIN=*
